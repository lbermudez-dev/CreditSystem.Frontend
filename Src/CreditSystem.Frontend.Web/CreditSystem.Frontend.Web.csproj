<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CreditSystem.Frontend.Web</RootNamespace>
    <UserSecretsId>d5f3f9d1-2e3c-4a10-9b2a-credit-system-frontend</UserSecretsId>

    <!--
      NOTA: se asume Blazor Web App con render mode Interactive Server,
      por ser el modelo de hosting mas simple para integrar con una API REST
      externa sin exponer la ApiKey al navegador. Si el proyecto real ya
      existe con otro modelo (WASM / Auto), reemplazar este csproj y
      Program.cs por los del proyecto existente y mover los Services/Models
      tal cual (no dependen del modelo de hosting).
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Sin dependencias NuGet adicionales de momento: solo se usa
         HttpClientFactory (incluido en el SDK Web) para consumir la API.
         No se agregan librerias de componentes (MudBlazor, Radzen, etc.)
         porque el usuario indico que el proyecto usa Bootstrap +
         ecosistema nativo de Blazor. -->
  </ItemGroup>

</Project>
