@page "/crm/riesgo/matrices"
@inject IRiskEngineService RiskEngineService

<PageTitle>Matrices de Riesgo | CACE</PageTitle>

<PageHeader Title="Matrices de Riesgo" Icon="grid_view"
            Breadcrumb="CRM / Motor de Riesgo"
            Subtitle="GET /api/v1/risk-matrices">
    <Actions>
        <a class="btn btn-primary d-flex align-items-center gap-2" href="/crm/riesgo/matrices/nuevo">
            <span class="material-symbols-outlined" style="font-size:18px;">add</span>
            Nueva Matriz
        </a>
    </Actions>
</PageHeader>

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="small fw-semibold text-uppercase text-muted mb-0" for="status-filter">Estado</label>
    <select id="status-filter" class="form-select form-select-sm" style="max-width:200px;"
            value="@_statusFilter" @onchange="OnStatusChanged">
        <option value="">Todas</option>
        <option value="@RiskMatrixStatuses.Draft">Draft</option>
        <option value="@RiskMatrixStatuses.Active">Active</option>
        <option value="@RiskMatrixStatuses.Superseded">Superseded</option>
    </select>
</div>

<DataTable TItem="RiskMatrixResponse"
           IsLoading="_isLoading"
           Error="_error"
           Items="_matrices"
           EmptyIcon="grid_view"
           EmptyTitle="Sin matrices de riesgo registradas"
           OnRetry="LoadAsync">
    <HeaderTemplate>
        <th>Nombre</th>
        <th class="text-center">Versión</th>
        <th>Estado</th>
        <th class="text-end">Umbral Auto-Aprobación</th>
        <th class="text-end">Umbral Auto-Rechazo</th>
        <th>Creada</th>
        <th></th>
    </HeaderTemplate>
    <RowTemplate Context="matrix">
        <td class="fw-semibold">@(matrix.Name ?? "—")</td>
        <td class="text-center cace-table-mono">@matrix.Version</td>
        <td><StatusBadge Status="@(matrix.Status ?? string.Empty)" /></td>
        <td class="text-end cace-table-mono">@matrix.AutoApproveThreshold.ToString("0.00")</td>
        <td class="text-end cace-table-mono">@matrix.AutoRejectThreshold.ToString("0.00")</td>
        <td>@matrix.CreatedAt.ToString("dd/MM/yyyy")</td>
        <td class="text-end">
            <a class="btn btn-sm btn-outline-secondary" href="@($"/crm/riesgo/matrices/{matrix.Id}")">
                <span class="material-symbols-outlined" style="font-size:16px;">visibility</span>
            </a>
        </td>
    </RowTemplate>
</DataTable>

@code {
    private bool _isLoading = true;
    private ApiError? _error;
    private List<RiskMatrixResponse>? _matrices;
    private string _statusFilter = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task OnStatusChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? string.Empty;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        var result = await RiskEngineService.ListRiskMatricesAsync(string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter);
        _isLoading = false;

        if (result.IsSuccess)
        {
            _matrices = result.Data;
        }
        else
        {
            _error = result.Error;
        }
    }
}
