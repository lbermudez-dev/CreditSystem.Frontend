@page "/crm/riesgo/reglas/{Id:guid}"
@inject IRiskEngineService RiskEngineService
@inject NavigationManager NavigationManager

<PageTitle>Detalle de Regla de Riesgo | CACE</PageTitle>

<PageHeader Title="@(_rule?.Name ?? "Regla de Riesgo")" Icon="rule_folder"
            Breadcrumb="CRM / Motor de Riesgo / Reglas / Detalle"
            Subtitle="@($"GET/PUT/DELETE /api/v1/risk-rules/{Id}")">
    <Actions>
        @if (_rule is not null)
        {
            <button class="btn btn-outline-danger d-flex align-items-center gap-2"
                    disabled="@(_deleteBlockedReason is not null)"
                    @onclick="() => _showDeleteConfirm = true">
                <span class="material-symbols-outlined" style="font-size:18px;">delete</span>
                Eliminar
            </button>
        }
    </Actions>
</PageHeader>

@if (_isLoading)
{
    <LoadingIndicator Message="Cargando regla..." />
}
else if (_loadError is not null)
{
    <ErrorState Error="_loadError" OnRetry="LoadAsync" />
}
else if (_rule is not null)
{
    @if (_deleteError is not null)
    {
        <div class="alert alert-danger small mb-2" style="max-width:680px;">@_deleteError.Message</div>
    }
    @if (_deleteBlockedReason is not null)
    {
        <div class="text-danger small mb-2" style="max-width:680px;white-space:pre-wrap;">No se puede eliminar: @_deleteBlockedReason</div>
    }
    <div class="cace-card p-4" style="max-width:680px;">
        <EditForm Model="_updateRequest" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label small fw-semibold text-uppercase text-muted">Nombre</label>
                <InputText class="form-control" @bind-Value="_updateRequest.Name" />
            </div>

            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Tipo de Regla</label>
                    <InputSelect class="form-select" @bind-Value="_updateRequest.RuleType">
                        <option value="RangeCheck">Rango (RangeCheck)</option>
                        <option value="ThresholdCheck">Umbral (ThresholdCheck)</option>
                        <option value="EnumCheck">Enumerado (EnumCheck)</option>
                    </InputSelect>
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold text-uppercase text-muted">Campo Objetivo</label>
                    @* DOCUMENTACION INSUFICIENTE: catalogo no confirmado de targetField; texto libre, el backend valida. *@
                    <InputText class="form-control" @bind-Value="_updateRequest.TargetField" placeholder="ej. MonthlyIncome" />
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label class="form-label small fw-semibold text-uppercase text-muted">Peso</label>
                <InputNumber class="form-control" @bind-Value="_updateRequest.Weight" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-uppercase text-muted d-flex justify-content-between align-items-center">
                    Parámetros
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddParameterRow">
                        <span class="material-symbols-outlined" style="font-size:16px;">add</span>
                    </button>
                </label>
                @foreach (var row in _parameterRows)
                {
                    <div class="d-flex gap-2 mb-2">
                        <input class="form-control" placeholder="Clave" @bind="row.Key" @bind:event="oninput" />
                        <input class="form-control" placeholder="Valor" @bind="row.Value" @bind:event="oninput" />
                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveParameterRow(row)">
                            <span class="material-symbols-outlined" style="font-size:16px;">delete</span>
                        </button>
                    </div>
                }
                @if (_parameterRows.Count == 0)
                {
                    <p class="text-muted small mb-0">Sin parámetros.</p>
                }
            </div>

            <p class="text-muted small mb-2">Para cambiar una regla en uso, cree una regla nueva y una nueva versión de la matriz que la use.</p>
            <p class="text-muted small mb-0">Creada: @_rule.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>

            @if (_updateBlockedReason is not null)
            {
                <div class="text-danger small mt-3" style="white-space:pre-wrap;">No se puede modificar: @_updateBlockedReason</div>
            }
            @if (_saveError is not null)
            {
                <div class="alert alert-danger small mt-3 mb-0">@_saveError.Message</div>
            }
            @if (_saveSuccess)
            {
                <div class="alert alert-success small mt-3 mb-0">Regla actualizada correctamente.</div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a class="btn btn-outline-secondary" href="/crm/riesgo/reglas">Volver</a>
                <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" disabled="@(_isSaving || _updateBlockedReason is not null)">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    Guardar Cambios
                </button>
            </div>
        </EditForm>
    </div>
}

<ConfirmDialog IsVisible="_showDeleteConfirm"
               Title="Eliminar Regla de Riesgo"
               Message="¿Está seguro de eliminar esta regla? Si está en uso por una matriz, el sistema no lo permitirá."
               IsBusy="_isDeleting"
               OnConfirm="DeleteAsync"
               OnCancel="() => _showDeleteConfirm = false" />

@if (_conflictMessage is not null)
{
    @* 409: el detail del backend lista cada matriz (nombre, version, estado); se muestra tal cual. *@
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold cace-text-primary">Regla en uso</h5>
                    <button type="button" class="btn-close" @onclick="CloseConflict" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0" style="white-space:pre-wrap;">@_conflictMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="CloseConflict">Entendido</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private sealed class ParamRow
    {
        public string Key { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private bool _isLoading = true;
    private ApiError? _loadError;
    private RiskRuleResponse? _rule;

    private readonly UpdateRiskRuleRequest _updateRequest = new();
    private readonly List<ParamRow> _parameterRows = new();

    private bool _isSaving;
    private bool _saveSuccess;
    private ApiError? _saveError;

    // 409 (RiskRule.NotEditableInUse / RiskRule.InUse): el backend es la fuente de verdad;
    // tras un 409 se deshabilita la accion en la sesion y se muestra el motivo.
    private string? _conflictMessage;
    private string? _updateBlockedReason;
    private string? _deleteBlockedReason;

    private ApiError? _deleteError;
    private bool _showDeleteConfirm;
    private bool _isDeleting;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;
        var result = await RiskEngineService.GetRiskRuleAsync(Id);
        _isLoading = false;

        if (result.IsSuccess)
        {
            _rule = result.Data;
            if (_rule is not null)
            {
                _updateRequest.Name = _rule.Name;
                _updateRequest.RuleType = _rule.RuleType;
                _updateRequest.TargetField = _rule.TargetField;
                _updateRequest.Weight = _rule.Weight;

                _parameterRows.Clear();
                if (_rule.Parameters is not null)
                {
                    foreach (var (key, value) in _rule.Parameters)
                    {
                        _parameterRows.Add(new ParamRow { Key = key, Value = value });
                    }
                }
            }
        }
        else
        {
            _loadError = result.Error;
        }
    }

    private void AddParameterRow() => _parameterRows.Add(new ParamRow());

    private void RemoveParameterRow(ParamRow row) => _parameterRows.Remove(row);

    // Claves repetidas: gana la ultima (ToDictionary lanzaria y tumbaria el circuito).
    private Dictionary<string, string> BuildParameters()
    {
        var dict = new Dictionary<string, string>();
        foreach (var row in _parameterRows.Where(r => !string.IsNullOrWhiteSpace(r.Key)))
        {
            dict[row.Key] = row.Value;
        }
        return dict;
    }

    private void CloseConflict() => _conflictMessage = null;

    private static bool IsInUseConflict(ApiError? e) =>
        e is not null && (e.Code == "RiskRule.NotEditableInUse" || e.Code == "RiskRule.InUse");

    private async Task SaveAsync()
    {
        _saveError = null;
        _saveSuccess = false;

        if (string.IsNullOrWhiteSpace(_updateRequest.Name) || string.IsNullOrWhiteSpace(_updateRequest.TargetField))
        {
            _saveError = new ApiError { Message = "Nombre y campo objetivo son obligatorios." };
            return;
        }

        if (_updateRequest.Weight <= 0)
        {
            _saveError = new ApiError { Message = "El peso debe ser mayor que 0." };
            return;
        }

        _isSaving = true;

        _updateRequest.Parameters = BuildParameters();

        var result = await RiskEngineService.UpdateRiskRuleAsync(Id, _updateRequest);

        _isSaving = false;

        if (result.IsSuccess)
        {
            _saveSuccess = true;
            _rule = result.Data ?? _rule;
        }
        else if (IsInUseConflict(result.Error))
        {
            _conflictMessage = result.Error!.Message;
            _updateBlockedReason = result.Error.Message;
        }
        else
        {
            _saveError = result.Error;
        }
    }

    private async Task DeleteAsync()
    {
        _isDeleting = true;
        _deleteError = null;

        var result = await RiskEngineService.DeleteRiskRuleAsync(Id);

        _isDeleting = false;

        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo("/crm/riesgo/reglas");
            return;
        }

        _showDeleteConfirm = false;

        if (IsInUseConflict(result.Error))
        {
            _conflictMessage = result.Error!.Message;
            _deleteBlockedReason = result.Error.Message;
            return;
        }

        _deleteError = result.Error;
    }
}
