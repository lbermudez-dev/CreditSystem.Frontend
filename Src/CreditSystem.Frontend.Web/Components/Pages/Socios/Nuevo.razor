@page "/socios/nuevo"
@inject IMemberService MemberService
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Socio | CACE</PageTitle>

<PageHeader Title="Afiliar Socio" Icon="person_add"
            Breadcrumb="Socios / Nuevo"
            Subtitle="POST /api/v1/members/enroll — afilia como socio cooperativo a un cliente que ya existe en el CRM (externalCustomerId)." />

<div class="cace-card p-4" style="max-width:560px;">
    <EditForm Model="_request" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label small fw-semibold text-uppercase text-muted">GUID del Cliente (externalCustomerId)</label>
            <InputText class="form-control" @bind-Value="_customerIdText" placeholder="3fa85f64-5717-4562-b3fc-2c963f66afa6" />
            @if (_invalidCustomerId)
            {
                <p class="text-danger small mt-1 mb-0">Debe ser un GUID válido.</p>
            }
        </div>

        <div class="mb-3">
            <label class="form-label small fw-semibold text-uppercase text-muted">Fecha de Afiliación</label>
            <InputDate class="form-control" @bind-Value="_request.JoinedAt" />
        </div>

        <div class="row g-3">
            <div class="col-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Aportación Inicial</label>
                <InputNumber class="form-control" @bind-Value="_request.InitialSharesAmount" />
            </div>
            <div class="col-6">
                <label class="form-label small fw-semibold text-uppercase text-muted">Moneda</label>
                <InputText class="form-control" @bind-Value="_request.SharesCurrency" placeholder="NIO" />
            </div>
        </div>

        @if (_message is not null)
        {
            <div class="alert @(_success ? "alert-success" : "alert-danger") small mt-3 mb-0">@_message</div>
        }

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a class="btn btn-outline-secondary" href="/socios">Cancelar</a>
            <button type="submit" class="btn btn-primary d-flex align-items-center gap-2" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                Afiliar Socio
            </button>
        </div>
    </EditForm>
</div>

@code {
    private EnrollMemberRequest _request = new()
    {
        JoinedAt = DateTime.Today,
        SharesCurrency = "NIO"
    };

    private string _customerIdText = string.Empty;
    private bool _invalidCustomerId;

    private bool _isSubmitting;
    private bool _success;
    private string? _message;

    private async Task SubmitAsync()
    {
        if (!Guid.TryParse(_customerIdText.Trim(), out var customerId))
        {
            _invalidCustomerId = true;
            return;
        }

        _invalidCustomerId = false;
        _isSubmitting = true;
        _message = null;

        _request.ExternalCustomerId = customerId;

        var result = await MemberService.EnrollAsync(_request);

        _isSubmitting = false;

        if (result.IsSuccess && result.Data is { Success: true, ExternalCustomerId: not null })
        {
            NavigationManager.NavigateTo($"/socios/{result.Data.ExternalCustomerId}");
            return;
        }

        _success = false;
        _message = result.Data?.Error ?? result.Error?.Message ?? "No fue posible afiliar al socio.";
    }
}
