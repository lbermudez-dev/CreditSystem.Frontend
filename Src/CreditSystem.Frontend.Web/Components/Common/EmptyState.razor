<div class="cace-state-panel">
    <span class="material-symbols-outlined">@Icon</span>
    <p class="mt-2 mb-1 fw-semibold cace-text-primary">@Title</p>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="mb-0 small">@Description</p>
    }
    @if (Actions is not null)
    {
        <div class="mt-3">@Actions</div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "inbox";
    [Parameter] public string Title { get; set; } = "Sin resultados";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
