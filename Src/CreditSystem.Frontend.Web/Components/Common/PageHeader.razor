<div class="d-flex flex-wrap justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        @if (!string.IsNullOrWhiteSpace(Breadcrumb))
        {
            <nav class="small text-muted mb-1">@Breadcrumb</nav>
        }
        <h2 class="h4 fw-bold cace-text-primary mb-0 d-flex align-items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <span class="material-symbols-outlined text-primary">@Icon</span>
            }
            @Title
        </h2>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="text-muted small mb-0">@Subtitle</p>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="d-flex gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Breadcrumb { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
