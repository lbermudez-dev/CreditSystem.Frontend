@* Replica el TopAppBar de Dash.html / ExpedientePersona.html / Creditos.html.
   DOCUMENTACION INSUFICIENTE: nombre y rol del usuario en sesion (ej.
   "Martha Leonor Silva - Analista Senior") vienen hardcodeados porque no
   hay endpoint ni esquema de autenticacion de usuario documentado (la
   autenticacion prevista es una ApiKey de servicio, sin usuario logueado).
   Reemplazar cuando exista un mecanismo real de identidad de usuario. *@
@using Microsoft.Extensions.Options
@inject IOptions<DummyDataSettings> DummyDataOptions

<header class="cace-header d-flex align-items-center justify-content-between px-3 px-lg-4">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-icon border-0 text-secondary d-lg-none" type="button" aria-label="Abrir menu">
            <span class="material-symbols-outlined">menu</span>
        </button>

        <div class="d-flex align-items-center gap-2">
            <span class="cace-brand-badge">C</span>
            <h1 class="h5 mb-0 fw-bold cace-text-primary d-none d-sm-block">CACE | Sistema de Gestión</h1>
            @if (DummyDataOptions.Value.Enabled)
            {
                <span class="cace-badge cace-badge-warning" title="Los datos que se muestran son generados, no provienen del backend real.">
                    Modo Demo · Datos de Prueba
                </span>
            }
        </div>
    </div>

    <div class="d-flex align-items-center gap-3">
        <div class="text-end d-none d-sm-block">
            <p class="mb-0 small fw-semibold cace-text-primary">Martha Leonor Silva</p>
            <p class="mb-0 small text-muted">Analista Senior</p>
        </div>
        <div class="cace-avatar">ML</div>
    </div>
</header>
